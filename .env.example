ANTHROPIC_API_KEY=

# Run on a real Shopify store instead of the sample catalog
STORE_BACKEND=shopify
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
STORE_BRAND_NAME=Your Store
# Your hosted UCP agent profile (defaults to Shopify's example profile, fine for development)
UCP_AGENT_PROFILE_URL=
# Dev Dashboard > Catalogs > API key. Optional: without it, checkout uses the cart's link.
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_BUYER_COUNTRY=US
CHECKOUT_UTM_SOURCE=claude_shopping_agent
